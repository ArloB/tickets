# Build artifacts. /bin/ already covers `task build` output; the old bare
# `tickets`/`tickets.exe` patterns here were a bug — unanchored, they also
# matched the cmd/tickets/ source directory and silently excluded it from
# git entirely. Keep patterns anchored to the repo root.
/bin/
/dist/
/tickets
/tickets.exe

# Safety net for stray `go build ./some/pkg` output dropped at the repo
# root without -o (bit us once with mcp.exe from the spike package).
/*.exe
/*.test

# SQLite runtime files
*.db
*.db-wal
*.db-shm
*.db-journal

# Web UI. dist/ is real Vite build output once `task web:build`/`npm
# run build` has run locally — only .gitkeep is tracked, so a local
# build never shows up as a dirty tracked file in `git status` (ADR
# 0010's placeholder scheme moved from a committed index.html to this
# once Phase 4 started producing real builds).
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# Playwright (task web:e2e) output — traces/reports from a local run.
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Local scratch / OS
.DS_Store
Thumbs.db
*.local

# Go tooling
/coverage.out
