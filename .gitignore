# Build artifacts. /bin/ already covers `task build` output; the old bare
# `tickets`/`tickets.exe` patterns here were a bug — unanchored, they also
# matched the cmd/tickets/ source directory and silently excluded it from
# git entirely. Keep patterns anchored to the repo root.
/bin/
/dist/
/tickets
/tickets.exe

# SQLite runtime files
*.db
*.db-wal
*.db-shm
*.db-journal

# Web UI
/web/node_modules/
/web/dist/*
!/web/dist/index.html

# Local scratch / OS
.DS_Store
Thumbs.db
*.local

# Go tooling
/coverage.out
